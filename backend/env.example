# ========================================
# Smart Finance Hub - Environment Variables
# ========================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5174

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/smart-finance
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/smart-finance

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# API Keys (Get these from respective services)

# News API (https://newsapi.org/)
NEWS_API_KEY=your-news-api-key-here

# CoinGecko API (https://www.coingecko.com/en/api)
COINGECKO_API_KEY=your-coingecko-api-key-here

# Binance API (https://www.binance.com/en/my/settings/api-management)
BINANCE_API_KEY=your-binanace-api-key-here
BINANCE_SECRET_KEY=your-binance-secret-key-here

# Alpha Vantage API (https://www.alphavantage.co/)
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key-here

# OpenAI API (https://platform.openai.com/) - Optional for AI features
OPENAI_API_KEY=your-openai-api-key-here

# Google Cloud TTS (https://cloud.google.com/text-to-speech) - Optional for voice features
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
GOOGLE_CLOUD_PRIVATE_KEY=your-google-cloud-private-key
GOOGLE_CLOUD_CLIENT_EMAIL=your-google-cloud-client-email

# Email Configuration (Optional for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# Redis Configuration (Optional for caching)
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_SALT_ROUNDS=12
SESSION_SECRET=your-session-secret-key

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3000

# File Upload (Optional)
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/

# Notification Settings
PUSH_NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=true

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_VOICE_FEATURES=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_SOCIAL_FEATURES=true

# Development Settings
DEBUG=true
ENABLE_MOCK_DATA=true
ENABLE_API_LOGGING=true

# Production Settings (set these in production)
# NODE_ENV=production
# DEBUG=false
# ENABLE_MOCK_DATA=false
# ENABLE_API_LOGGING=false


